{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project BIT Monthly Historical Timeline",
  "type": "object",
  "required": [
    "dataset",
    "dataset_version",
    "year",
    "month",
    "period",
    "events"
  ],
  "properties": {
    "dataset": {
      "const": "project_bit_historical_timeline"
    },
    "dataset_version": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "date_precision",
          "known_as_of",
          "category",
          "scope",
          "headline",
          "summary",
          "tags",
          "economic_sectors",
          "game_relevance",
          "importance",
          "source_keys"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "date_precision": {
            "enum": [
              "day",
              "month"
            ]
          },
          "known_as_of": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "economic_sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "game_relevance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "source_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}